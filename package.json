    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
